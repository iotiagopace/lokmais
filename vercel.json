{
  "cleanUrls": true,
  "routes": [
    { "src": "^/$", "has": [{ "type": "host", "value": "lokmaisminas.vercel.app" }], "dest": "/lp-minas", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } },
    { "src": "^/$", "has": [{ "type": "host", "value": "belohorizonte.lokmais.com" }], "dest": "/lp-minas", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" } }
  ],
  "rewrites": [
    { "source": "/contagem", "destination": "/unidade" },
    { "source": "/manaus",   "destination": "/unidade" },
    { "source": "/sao-paulo", "destination": "/unidade" },
    { "source": "/lp-minas", "destination": "/lp-minas/index.html" }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/simulador",
      "destination": "/planos",
      "permanent": true
    },
    {
      "source": "/simulador.html",
      "destination": "/planos",
      "permanent": true
    },
    {
      "source": "/lp-seja-franqueado.html",
      "destination": "/seja-franqueado",
      "permanent": true
    },
    {
      "source": "/lp-seja-franqueado",
      "destination": "/seja-franqueado",
      "permanent": true
    },
    {
      "source": "/seja-franqueado.html",
      "destination": "/seja-franqueado",
      "permanent": true
    },
    {
      "source": "/sejafranqueado.html",
      "destination": "/seja-franqueado",
      "permanent": true
    },
    {
      "source": "/sejafranqueado",
      "destination": "/seja-franqueado",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/lp-minas/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "lokmaisminas.vercel.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
