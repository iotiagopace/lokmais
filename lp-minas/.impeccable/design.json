  "components": [
    {
      "name": "Botão primary",
      "kind": "button",
      "refersTo": "button-primary",
      "html": "<button class=\"ds-button-primary\">Quero essa moto</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;min-height:54px;padding:15px 28px;border:0;border-radius:0;background:var(--orange,#f47a18);color:var(--ink,#111b2b);font-family:var(--font,\"General Sans\",Arial,sans-serif);font-size:1rem;font-weight:600;line-height:1.5;cursor:pointer;transition:background .18s,transform .18s cubic-bezier(.16,1,.3,1)}.ds-button-primary:hover{background:#ff963e;transform:translateY(-2px)}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:focus-visible{outline:3px solid var(--orange,#f47a18);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}",
      "description": "Ação sólida e foco explícito; CTA comercial varia por modalidade."
    },
    {
      "name": "Botão light",
      "kind": "button",
      "refersTo": "button-light",
